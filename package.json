{
  "name": "mattermost-mcp",
  "version": "0.2.0",
  "description": "Read-only MCP server for Mattermost (stdio or hosted Streamable HTTP): list channels, read channels, threads and unread messages, search posts",
  "private": true,
  "type": "module",
  "bin": {
    "mattermost-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsc && node --test dist/*.test.js",
    "start:http": "MCP_TRANSPORT=http node dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
